{
  "name": "catalogo-pg",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Catálogo visual para clientes desde Google Sheets (Cloudflare Pages + Functions + D1).",
  "scripts": {
    "dev": "wrangler pages dev public --d1 DB=catalogo-pg-db",
    "deploy": "wrangler pages deploy public",
    "db:migrate": "wrangler d1 migrations apply catalogo-pg-db --remote",
    "test:server": "node tests/devserver.mjs . 8788 tests/.test.sqlite",
    "test:api": "node tests/apitest.mjs http://localhost:8788",
    "check": "node --check public/assets/app-main.js && node --check \"functions/api/[[path]].js\""
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "wrangler": "^3.114.0"
  }
}
